# App settings
APP_ENV=development
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:5173

# Backend
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
# JWT_PRIVATE_KEY and JWT_PUBLIC_KEY are optional. Use them only when JWT_ALGORITHM is RS256, ES256, PS256, etc.
# Example:
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
DATABASE_URL=postgresql+psycopg://mbaara:mbaara@127.0.0.1:5432/mbaara_dev
REDIS_URL=redis://127.0.0.1:6379/0
VITE_API_BASE_URL=http://127.0.0.1:8000

# API URL for frontend development.
# If using a tunnel, replace this with the tunnel URL returned by `npm run dev:tunnel`.
# Example: VITE_API_BASE_URL=https://your-tunnel-url.loca.lt

# Supabase auth config
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Audio / TTS Configuration
# ═══════════════════════════════════════════════════════════════

# Existing Audio Config
WHISPER_MODEL=small
TTS_PROVIDER=browser

# NEW: Meta MMS / Coqui XTTS-v2 Configuration
# ─────────────────────────────────────────
# Coqui TTS Server endpoint (for MMS models: sus, mnk, bam, etc.)
# Deploy on Render or local Docker
COQUI_TTS_URL=http://localhost:5000
# Or for production on Render:
# COQUI_TTS_URL=https://mbaara-tts-server.onrender.com

# NEW: Upstash Redis Cache (for TTS synthesis caching)
# ─────────────────────────────────────────────────────
# Free tier: 10k commands/day
# Sign up: https://upstash.com
# Redis URL format: redis://default:<password>@<host>:<port>
REDIS_URL=redis://127.0.0.1:6379/0
# Production example:
# REDIS_URL=redis://default:xxxxxxxx@us1-yyyyyy.upstash.io:6379

# Premium TTS providers (optional, disabled by default)
# Activate only when explicitly needed
ENABLE_PREMIUM_TTS=false
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Storage
UPLOAD_DIR=./uploads
