  "grammar_points": [
    {
      "concept": "Demander un prix avec 'jeli' (combien)",
      "explanation": "La structure interrogative de prix place 'jeli' (combien) suivi de 'di' à la fin de la question, après le nom du produit.",
      "rules": [
        "Structure : [Produit] + ye + jeli + di ?",
        "Réponse : [Nombre] + le"
      ],
