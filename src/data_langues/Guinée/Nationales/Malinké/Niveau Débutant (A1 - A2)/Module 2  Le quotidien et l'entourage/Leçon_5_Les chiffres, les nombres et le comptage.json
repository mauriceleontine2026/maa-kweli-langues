  "grammar_points": [
    {
      "concept": "La formation additive des nombres (11 à 19, 21 à 29...)",
      "explanation": "Les nombres composés se forment en ajoutant l'unité à la dizaine avec le mot 'ni' (et).",
      "rules": [
        "Structure : [Dizaine] + ni + [Unité]",
        "tan (10) + ni + kelen (1) = tan ni kelen (11)",
        "muwan (20) + ni + fila (2) = muwan ni fila (22)"
      ],
      "examples": [
        {
          "structure": "tan ni [unité]",
          "phonetic_api": "[tan ni]",
          "meaning": "onze à dix-neuf"
        },
        {
          "structure": "muwan ni [unité]",
          "phonetic_api": "[muwan ni]",
          "meaning": "vingt-et-un à vingt-neuf"
        }
      ]
    },
    {
      "concept": "Les dizaines formées avec le préfixe 'bi-'",
      "explanation": "À partir de trente, les dizaines (sauf vingt='muwan') se forment avec le préfixe 'bi-' suivi du chiffre correspondant à la dizaine.",
      "rules": [
        "bi- + saba (3) = bisaba (30)",
        "bi- + naanin (4) = binaanin (40)",
        "bi- + lolu (5) = bilolu (50)"
      ],
      "examples": [
        {
          "structure": "bi- + [chiffre]",
          "phonetic_api": "[bi]",
          "meaning": "dizaine correspondante (30, 40, 50...)"
        }
      ]
    }
  ],
