  "grammar_points": [
    {
      "concept": "Le présent progressif 'ye ... la' pour les loisirs",
      "explanation": "Pour dire qu'une activité de loisir est en train de se dérouler, on utilise la structure du présent progressif déjà connue : Sujet + ye + [verbe-nom] + la.",
      "rules": [
        "Structure : [Sujet] + ye + [verbe] + la",
        "Le verbe intransitif garde sa forme de nom : 'tolon' (jeu) devient 'tolonna' avec 'la'"
      ],
      "examples": [
        {
          "structure": "[Sujet] ye [verbe] la",
          "phonetic_api": "[je la]",
          "meaning": "[Sujet] est en train de [verbe]"
        }
      ]
    },
    {
      "concept": "Combiner deux actions avec le participe présent '-to'",
      "explanation": "Pour exprimer deux actions simultanées (ex. chanter en marchant), on utilise le participe présent en '-to' sur le premier verbe, suivi du second verbe conjugué normalement.",
      "rules": [
        "Structure : [Sujet] + [verbe1]-to, [sujet] + ye + [verbe2] + la",
        "'A wato' (lui, en allant/marchant) + 'ye donkili lala' (chante)"
      ],
      "examples": [
        {
          "structure": "[Sujet] [verbe1]-to, ye [verbe2] la",
          "phonetic_api": "[to]",
          "meaning": "en [verbe1]-ant, [sujet] fait [verbe2]"
        }
      ]
    }
  ],
