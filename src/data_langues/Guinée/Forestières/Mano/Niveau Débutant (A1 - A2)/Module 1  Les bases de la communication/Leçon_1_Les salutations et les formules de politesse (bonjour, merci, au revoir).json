  "grammar_points": [
    {
      "concept": "Distinction singulier/pluriel dans les salutations",
      "explanation": "En mano, presque toutes les formules de politesse existent en deux versions : une pour une seule personne (avec le pronom non-sujet ī 'toi') et une pour plusieurs personnes (avec kā 'vous'). Ce redoublement pronominal est systématique dans les salutations, contrairement au français où 'bonjour' ne change pas.",
      "rules": [
        "ī = 'toi' (singulier) s'utilise avec une personne",
        "kā = 'vous' (pluriel) s'utilise avec plusieurs personnes",
        "La formule de remerciement/salutation se construit souvent : pronom + racine (ex. ī/kā + sɛ̀kɛ̄ɛ̀, ī/kā + túòwàá)"
      ],
      "examples": [
        {
          "structure": "ī + sɛ̀kɛ̄ɛ̀",
          "phonetic_api": "/ī sɛ̀kɛ̄ɛ̀/",
          "meaning": "merci (à toi)"
        },
        {
          "structure": "kā + sɛ̀kɛ̄ɛ̀",
          "phonetic_api": "/kā sɛ̀kɛ̄ɛ̀/",
          "meaning": "merci (à vous)"
        }
      ]
    }
  ],
